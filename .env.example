# Contact form settings. Set these in Netlify → Site configuration → Environment variables.
# Copy to `.env` to test email delivery locally (`.env` is git-ignored).

# Where inquiries are emailed. Placeholder until the hosts have an inbox;
# while it is the placeholder, inquiries are only saved to Netlify Forms.
CONTACT_TO_EMAIL=hosts@example.com

# Sender shown on the email. Must use a domain verified with Resend.
CONTACT_FROM_EMAIL="Minpaku <hello@minpaku.ca>"

# API key from https://resend.com (free tier is plenty). Leave empty to skip email.
RESEND_API_KEY=
